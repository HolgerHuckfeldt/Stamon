{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "EF": "D:\\Stamon\\stats.db",
    "Name": "Holgers",
    "Provider": [
      {
        "Type": "Memory",
        "Name": "Sekunden",
        "Default": true,
        "Scale": {
          "Duration": 120,
          "Scale": "Second"
        }
      },
      {
        "Type": "EF",
        "Name": "Minuten",
        "Default": false,
        "Scale": {
          "Duration": 15,
          "Scale": "Minute"
        }
      }
    ]
  }
}
